# Example environment file for the Global Signal Fabric.
# Copy to .env and fill in only what you have. Missing keys are skipped, never required.

# SEC EDGAR (REQUIRED for SEC loader; format: "Project Name contact@example.com")
SEC_USER_AGENT=

# Etherscan (read-only)
ETHERSCAN_API_KEY=

# Optional placeholder sources (all currently disabled by default)
NEWSAPI_KEY=
EVENT_REGISTRY_KEY=
GROK_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=
SOLSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=

# Reminder: this MVP is ADVISORY_ONLY.
# No broker / authenticated-trading credentials belong in this file.
