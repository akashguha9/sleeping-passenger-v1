# Global Signal Fabric — example API key environment variables (Phase 2)
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.
# All loaders skip cleanly if their required key is absent — no test failure.

# SEC EDGAR (required to identify your application per SEC fair-access policy)
# Format: "AppName/version contact@example.com"
SEC_USER_AGENT=YourAppName/1.0 your_email@example.com

# Etherscan Ethereum blockchain data
# Obtain at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# NewsAPI news aggregator
# Obtain at: https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Event Registry structured news data
# Obtain at: https://eventregistry.org/register
EVENT_REGISTRY_API_KEY=your_event_registry_key_here

# xAI Grok API
# Obtain at: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# UK Companies House
# Obtain at: https://developer.company-information.service.gov.uk/
UK_COMPANIES_HOUSE_API_KEY=your_ch_api_key_here

# Japan EDINET (Financial Services Agency)
# Obtain at: https://disclosure.edinet-fsa.go.jp
EDINET_API_KEY=your_edinet_api_key_here

# Solscan Pro API (Solana blockchain)
# Obtain at: https://pro-api.solscan.io
SOLSCAN_API_KEY=your_solscan_api_key_here

# EVM JSON-RPC endpoint (Infura, Alchemy, or self-hosted node)
# Example Infura: https://mainnet.infura.io/v3/YOUR_PROJECT_ID
EVM_RPC_URL=https://mainnet.infura.io/v3/your_infura_project_id_here
