# ---------------------------------------------------------------------------
# Frontend environment — Next.js
# ---------------------------------------------------------------------------
# Only NEXT_PUBLIC_* vars are exposed to the browser.  Never put secrets here.
#
# Use 127.0.0.1 (not localhost) to avoid IPv6 ambiguity and to ensure CORS
# works correctly when the frontend is served from http://sleepingpassenger.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
