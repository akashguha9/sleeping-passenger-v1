{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "narrative_intent/distortion_report.schema.json",
  "title": "DistortionReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "domain",
    "distortion_score",
    "distortion_types",
    "frame_content_mismatch",
    "summary"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "enum": [
        "markets",
        "social_media",
        "football_messaging",
        "interpersonal"
      ]
    },
    "distortion_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "distortion_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "contradiction",
          "omission",
          "simplification",
          "incongruity",
          "taboo_insertion",
          "frame_content_mismatch",
          "compression",
          "identity_disruption"
        ]
      }
    },
    "frame_content_mismatch": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "summary": {
      "type": "string"
    },
    "functional_role_hint": {
      "type": "string",
      "enum": [
        "unknown",
        "stabilizing",
        "protective",
        "exploitative",
        "motivational",
        "emergent",
        "confusion_masking"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}