# ---------------------------------------------------------------------------
# Signal Advisory API — local FastAPI server
# Owner auth is REQUIRED (fail-closed default): set MVP_API_TOKEN_HASH
# (preferred) or legacy MVP_API_TOKEN. Everything else is optional.
# Never commit real secrets to .env.
# ---------------------------------------------------------------------------

# Backend bind host/port. Use 0.0.0.0 inside containers.
API_HOST=127.0.0.1
API_PORT=8000

# CORS allowlist (comma-separated). Defaults cover local dev + the
# sleepingpassenger hosts-file mapping.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://sleepingpassenger,http://sleepingpassenger.local

# REQUIRED owner auth — the server fails closed and refuses to start
# without it. All journal routes (reads and writes) then require
# `Authorization: Bearer <token>`.
#
# PREFERRED: hash mode. Only the SHA-256 of the token is stored; the raw
# token is printed once at generation and never sits on disk:
#   python scripts/generate_api_token.py --write-env          # first run
#   python scripts/generate_api_token.py --rotate --write-env # rotation
MVP_API_TOKEN_HASH=
# LEGACY fallback: plaintext token. Still works but logs a startup
# warning; hash mode wins when both are set. Prefer MVP_API_TOKEN_HASH.
MVP_API_TOKEN=
# Dev-only escape hatch: MVP_ALLOW_UNAUTH=1 runs an UNAUTHENTICATED
# loopback-only server; it is refused on any non-loopback bind.

# Non-loopback exposure hard stop. A bearer token over plain HTTP is
# readable on the network path, so binding beyond loopback (or setting
# MVP_PUBLIC_MODE=1) additionally requires ONE acknowledgement:
#   MVP_TLS_TERMINATED=1            TLS reverse proxy/tunnel in front
#   MVP_TRUSTED_PROXIES=<ip-list>   declared reverse proxy allowlist
#   MVP_PUBLISHED_BIND=127.0.0.1    container 0.0.0.0 mapped to host loopback
#   MVP_UNSAFE_LAN_HTTP=I_UNDERSTAND_THIS_EXPOSES_MY_TOKEN   (last resort)
MVP_PUBLIC_MODE=0
MVP_TLS_TERMINATED=0
MVP_PUBLISHED_BIND=
MVP_UNSAFE_LAN_HTTP=

# Secret custody for provider API keys (docs/SECRET_CUSTODY.md):
#   env                         keys come from env/.env (default; plaintext at rest)
#   windows-credential-manager  keys live in Windows Credential Manager (DPAPI)
# Manage with: python scripts/manage_secrets.py {list-names,set,get,delete,audit}
SECRET_PROVIDER=

# Emergency read-only mode (docs/INCIDENT_LOCKDOWN.md). 1 = every mutating
# route returns 423 Locked; reads stay token-gated; use during suspected
# compromise / token leak / shared-machine situations.
MVP_LOCKDOWN_MODE=0

# Tamper-evident audit log (hash-chained JSONL; docs/SECURITY.md).
# Defaults to logs/audit_log.jsonl — gitignored, stays on this machine.
MVP_AUDIT_LOG_PATH=

# Evidence ledger (Pass 4; docs/MODEL_PIPELINE_MAP.md). Hashed, redacted
# evidence items. Defaults to runtime/evidence_ledger.jsonl (gitignored).
MVP_EVIDENCE_LEDGER_PATH=

# Shadow-paper tournament ledger (Pass 5). Hypothetical advisory
# observations ONLY (NOT_AN_ORDER stamped; order-shaped rows refused).
# Defaults to runtime/shadow_paper_ledger.jsonl (gitignored).
MVP_SHADOW_LEDGER_PATH=

# Derived score ledger (Pass 6). Hash-chained model outputs, each linked
# to evidence ids or forced to NO_EVIDENCE_ABSTAIN; execution-shaped
# fields refused. Defaults to runtime/derived_score_ledger.jsonl.
MVP_DERIVED_SCORE_LEDGER_PATH=

# Host-header allowlist for DNS-rebinding defense (comma-separated, no
# ports). Defaults cover localhost / 127.0.0.1 / ::1 / sleepingpassenger.
MVP_ALLOWED_HOSTS=

# SQLite location. Defaults to runtime/mvp_local.db inside the repo.
MVP_DB_PATH=runtime/mvp_local.db

# Free-form environment tag surfaced on /health.
MVP_ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Live source configuration
# ---------------------------------------------------------------------------

# SEC EDGAR identity header (RFC: "AppName contact@example.com"). Required
# for any SEC fetch; without it the loader skips cleanly. Use a real email.
SEC_USER_AGENT="sleeping-passenger-v1 local advisory MVP your-email@example.com"

# SEC fetch mode — set EITHER a single CIK or enable the built-in 7-stock
# watchlist (Apple, Microsoft, Nvidia, Tesla, Amazon, Meta, Alphabet).
# Leaving both blank causes SEC to skip with a clear reason.
SEC_DEFAULT_CIK=
SEC_DEFAULT_WATCHLIST=

# GDELT HTTP timeout in seconds for the primary request. Loader default is
# 6s; raise to 10-15s if scheduled runs see frequent timeouts/rate limits.
GDELT_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Asia Disclosure — official free/public disclosure APIs
# ---------------------------------------------------------------------------

# Japan EDINET official API.
# Put the real value only in .env, never in .env.example.
EDINET_API_KEY=

# Optional alias if code expects this naming style.
# Leave blank here; in .env you may set it equal to EDINET_API_KEY if needed.
JAPAN_EDINET_API_KEY=

# Korea OpenDART official API.
# Put the real value only in .env, never in .env.example.
OPENDART_API_KEY=

# Optional alias if code expects this naming style.
# Leave blank here; in .env you may set it equal to OPENDART_API_KEY if needed.
KOREA_DART_API_KEY=

# Public-page Asia Disclosure sources are view-only and should not require keys:
# HKEXnews, CNINFO/SSE/SZSE, SGX announcements, Taiwan MOPS,
# Saudi Exchange/Tadawul, UAE ADX/DFM.
#
# Gated/subscriber sources should NOT be treated as free APIs:
# Japan TDnet API, Singapore ACRA API.

# ---------------------------------------------------------------------------
# Etherscan — public on-chain transactions ONLY
# ---------------------------------------------------------------------------

# Address is record-only; this MVP never signs, never broadcasts.
# ETHERSCAN_ADDRESS wins; ETHEREUM_ADDRESS / PUBLIC_ETH_ADDRESS may be accepted
# as fallbacks by loaders if implemented.
ETHERSCAN_API_KEY=
ETHERSCAN_ADDRESS=
ETHEREUM_ADDRESS=
PUBLIC_ETH_ADDRESS=

# ---------------------------------------------------------------------------
# Optional AI / narrative source configuration
# ---------------------------------------------------------------------------

XAI_API_KEY=
XAI_API_BASE_URL=https://api.x.ai/v1
XAI_MODEL=

# ---------------------------------------------------------------------------
# Pipeline / data flags — advisory only
# ---------------------------------------------------------------------------

PIPELINE_QUOTE_PROVIDER=yahoo

# Execution must remain disabled. This MVP is advisory-only.
PIPELINE_ENABLE_PAPER_EXECUTION=false
PIPELINE_ENABLE_LIVE_EXECUTION=false

# Polymarket public/read-only endpoints.
POLY_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLY_DATA_BASE_URL=https://data-api.polymarket.com
POLY_CLOB_BASE_URL=https://clob.polymarket.com

# Kalshi public/read-only market-data endpoint base.  Only public market
# discovery endpoints (GET /markets, GET /events) are used.  No API key
# is sent, no trading / portfolio / account endpoints are called.
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
# Optional local-only mock fixtures for the Kalshi loader (=1 to enable).
# Mock rows are tagged is_mock_fixture=true and MUST NOT be treated as live.
KALSHI_USE_MOCK_FIXTURES=

# Blockscout public/read-only configuration.
BLOCKSCOUT_API_BASE_URL=https://api.blockscout.com
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_DEFAULT_CHAIN_ID=1

# Signal refinery local configuration.
SIGNAL_REFINERY_DB_PATH=data/processed/signal_refinery.sqlite
SIGNAL_REFINERY_EDGE_THRESHOLD=0.08
SIGNAL_REFINERY_SIMULATED_STAKE=100.0
SIGNAL_REFINERY_PUBLIC_ONLY=true
SIGNAL_REFINERY_ENABLE_PAPER_ONLY=true

# ---------------------------------------------------------------------------
# Integrated Sprint — typed config schema (scripts/typed_config.py)
# These fields are READ ONLY by the local advisory MVP. Defaults preserve
# behaviour when unset. Safety-breaking values fail fast at startup.
# ---------------------------------------------------------------------------

# Diagnostics tail budget — bounds cold-recompute on the 122k-row hot path.
DIAGNOSTICS_SNAPSHOT_TTL_SECONDS=300
DIAGNOSTICS_COLD_RECOMPUTE_BUDGET_MS=8000
DIAGNOSTICS_HOT_CACHE_BUDGET_MS=750
DIAGNOSTICS_MAX_ROW_SCAN_ON_COLD_PATH=25000

# Provider enables (boolean: 1/0, true/false, yes/no).
YFINANCE_ENABLED=true
SEC_EDGAR_ENABLED=true
GDELT_ENABLED=true
NEWSAPI_ENABLED=false
NEWSAPI_KEY=

# Source freshness SLAs (hours). Promotion is downgraded when a source class
# is older than its SLA.
SOURCE_PRICE_SLA_HOURS=24
SOURCE_FILINGS_SLA_HOURS=72
SOURCE_NEWS_SLA_HOURS=24
SOURCE_AI_REPORT_SLA_HOURS=24

# AI report ingestion location + per-model reliability ledger path.
AI_REPORTS_ENABLED=true
AI_REPORTS_DIR=data/ai_reports
MODEL_RELIABILITY_LEDGER_PATH=runtime/model_reliability_ledger.json

# Advisory-safety invariants. These MUST remain true / LOCKED; the typed
# config schema raises ConfigSafetyError if any of them is altered.
ADVISORY_ONLY=true
HUMAN_EXECUTION_REQUIRED=true
EXECUTION_GATE=LOCKED

# ---------------------------------------------------------------------------
# Sprint 3 — operator-run live provider refresh (yfinance / SEC EDGAR / GDELT)
# All defaults are SAFE: refresh is off, advisory-only is required.  Setting
# MVP_LIVE_REFRESH_OK=1 *requires* the safety floor to stay intact.  The
# operator runs scripts/operator_live_provider_refresh.py manually; CI never
# enables this.
# ---------------------------------------------------------------------------
MVP_LIVE_REFRESH_OK=0
LIVE_REFRESH_TIMEOUT_SECONDS=45
LIVE_REFRESH_PROVIDER_ALLOWLIST=yfinance,sec_edgar,gdelt
OPERATOR_LIVE_REFRESH_TTL_HOURS=24
YFINANCE_LIVE_ENABLED=true
SEC_EDGAR_LIVE_ENABLED=true
GDELT_LIVE_ENABLED=true
LIVE_REFRESH_MAX_TICKERS=44
LIVE_REFRESH_REQUIRE_ADVISORY_ONLY=true