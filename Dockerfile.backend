# syntax=docker/dockerfile:1.7
#
# Backend container for the local advisory MVP.
#
# Hardened post-audit (S4):
#   * Runs as non-root user `app` (UID 10001).
#   * Installs production requirements only.  Use Dockerfile.test for CI.
#   * No dangling `adapters` copy (the directory does not exist in repo).
#   * No secrets are baked in -- pass via `docker run -e` or compose env.
#
# Build:
#     docker build -f Dockerfile.backend -t sleeping-passenger-backend:dev .
#
# Run (mount the host runtime/ so journaled data survives container removal):
#     docker run --rm -p 127.0.0.1:8000:8000 \
#         -e API_HOST=0.0.0.0 -e API_PORT=8000 -e MVP_ENVIRONMENT=docker \
#         -e MVP_API_TOKEN=... \
#         -v "$PWD/runtime":/app/runtime \
#         sleeping-passenger-backend:dev

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# S4: install production deps ONLY.  Dev/test deps live in
# requirements-dev.txt and ship via a separate Dockerfile if needed.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir fastapi "uvicorn[standard]"

# Application code -- explicit copies only.  Avoid copying runtime/, .env,
# tests/, frontend/, or any *.md docs.  Note: `adapters/` was removed from
# the original COPY list because the directory does not exist.
COPY scripts ./scripts
COPY config ./config
COPY configs ./configs
COPY src ./src

# Runtime DB + logs.  Compose mounts host runtime/ over /app/runtime.
RUN mkdir -p /app/runtime /app/logs

# S4: create a dedicated non-root user with a high UID so it cannot collide
# with host system users when the runtime volume is bind-mounted.
RUN groupadd -r -g 10001 app \
 && useradd  -r -u 10001 -g app --no-create-home --shell /sbin/nologin app \
 && chown -R app:app /app

USER app

ENV API_HOST=0.0.0.0 \
    API_PORT=8000 \
    MVP_ENVIRONMENT=docker \
    MVP_DB_PATH=/app/runtime/mvp_local.db

EXPOSE 8000

# /health is the minimal unauthenticated liveness probe (D2).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; \
import json; \
r=urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3); \
sys.exit(0 if json.load(r).get('status')=='ok' else 1)" || exit 1

CMD ["python", "scripts/api_server.py"]
