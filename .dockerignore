# Secrets and env files — never bake into images.
.env
.env.*
*.env
configs/api_keys*.env
frontend/.env
frontend/.env.*

# Runtime data — must be mounted as a volume, not copied into the image.
runtime/
logs/
data/
**/runtime/
**/logs/

# Local DBs
*.db
*.sqlite
*.sqlite3

# Python build artifacts
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node / Next.js — install/build inside the container.
node_modules/
**/node_modules/
frontend/.next/
frontend/out/
frontend/coverage/

# Git / editor / OS noise
.git/
.gitignore
.github/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Local one-off artifacts
audit_bundle/
audit_bundle.zip
backup/
notes/
linkedin/
prompts/
scorecards/
moltbook/
chronology/

# Docker artifacts themselves
Dockerfile*
docker-compose*.yml
.dockerignore
